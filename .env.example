# Copy to .env and adjust. The API server reads these on start.
PORT=4000
DB_MODE=oracle                      # oracle | memory (memory needs no database server)
ORACLE_USER=waretrack
ORACLE_PASSWORD=WareTrack_2026
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=30                     # "Keep me signed in" sessions last this long and renew while used

# AI operations assistant (optional). The exception watcher (Alerts tab) works without it.
# Get a key at https://console.anthropic.com — it is used only by the server, never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
